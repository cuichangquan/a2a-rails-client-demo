# Example configuration only; copy individual export values to your shell.
# This file is not automatically loaded.
A2A_AGENT_CARD_URL=https://agent.example.com/.well-known/agent-card.json
A2A_ALLOWED_ORIGINS=https://agent.example.com
# Optional: for authenticated JSON-RPC endpoint, scope to exact RPC origin.
# A2A_RPC_TOKEN=REPLACE_ME
# A2A_RPC_CREDENTIAL_ORIGIN=https://agent.example.com
# Optional: private Agent Card endpoint, bound to Card origin.
# A2A_CARD_TOKEN=REPLACE_ME
# A2A_CARD_CREDENTIAL_ORIGIN=https://agent.example.com
